\relax 
\providecommand\hyper@newdestlabel[2]{}
\@writefile{toc}{\contentsline {chapter}{Liste des acronymes}{13}{chapter*.7}\protected@file@percent }
\newacro{AASM}[\AC@hyperlink{AASM}{AASM}]{\emph  {American Academy of Sleep Medicine} --- société savante dont le manuel constitue le référentiel international de scorage du sommeil}
\newacro{API}[\AC@hyperlink{API}{API}]{\emph  {Application Programming Interface} --- interface de programmation applicative}
\newacro{AUC}[\AC@hyperlink{AUC}{AUC}]{\emph  {Area Under the Curve} --- aire sous la courbe ROC}
\newacro{CNI}[\AC@hyperlink{CNI}{CNI}]{Centre National de l'Informatique}
\newacro{CNN}[\AC@hyperlink{CNN}{CNN}]{\emph  {Convolutional Neural Network} --- réseau de neurones convolutif}
\newacro{CPAP}[\AC@hyperlink{CPAP}{CPAP}]{\emph  {Continuous Positive Airway Pressure} --- pression positive continue}
\newacro{CSV}[\AC@hyperlink{CSV}{CSV}]{\emph  {Comma-Separated Values} --- format tabulaire à valeurs séparées}
\newacro{ECG}[\AC@hyperlink{ECG}{ECG}]{Électrocardiogramme}
\newacro{EDF}[\AC@hyperlink{EDF}{EDF}]{\emph  {European Data Format} --- format standard d'échange des signaux physiologiques}
\newacro{EEG}[\AC@hyperlink{EEG}{EEG}]{Électroencéphalogramme}
\newacro{EMG}[\AC@hyperlink{EMG}{EMG}]{Électromyogramme}
\newacro{EOG}[\AC@hyperlink{EOG}{EOG}]{Électro-oculogramme}
\newacro{IAH}[\AC@hyperlink{IAH}{IAH}]{Index d'Apnées-Hypopnées --- nombre moyen d'événements respiratoires par heure de sommeil}
\newacro{JWT}[\AC@hyperlink{JWT}{JWT}]{\emph  {JSON Web Token} --- jeton d'authentification signé}
\newacro{LSTM}[\AC@hyperlink{LSTM}{LSTM}]{\emph  {Long Short-Term Memory} --- réseau récurrent à mémoire longue}
\newacro{MESA}[\AC@hyperlink{MESA}{MESA}]{\emph  {Multi-Ethnic Study of Atherosclerosis} --- cohorte épidémiologique diffusée par le NSRR}
\newacro{MLOps}[\AC@hyperlink{MLOps}{MLOps}]{\emph  {Machine Learning Operations} --- industrialisation du cycle de vie des modèles}
\newacro{NREM}[\AC@hyperlink{NREM}{NREM}]{\emph  {Non-Rapid Eye Movement} --- sommeil sans mouvements oculaires rapides}
\newacro{NSRR}[\AC@hyperlink{NSRR}{NSRR}]{\emph  {National Sleep Research Resource} --- plateforme de diffusion des cohortes de recherche sur le sommeil}
\newacro{ORM}[\AC@hyperlink{ORM}{ORM}]{\emph  {Object-Relational Mapping} --- correspondance objet-relationnel}
\newacro{PSG}[\AC@hyperlink{PSG}{PSG}]{Polysomnographie --- enregistrement nocturne multi-signaux de référence}
\newacro{RAM}[\AC@hyperlink{RAM}{RAM}]{\emph  {Random Access Memory} --- mémoire vive}
\newacro{RBAC}[\AC@hyperlink{RBAC}{RBAC}]{\emph  {Role-Based Access Control} --- contrôle d'accès fondé sur les rôles}
\newacro{RDI}[\AC@hyperlink{RDI}{RDI}]{\emph  {Respiratory Disturbance Index} --- index de perturbation respiratoire}
\newacro{REM}[\AC@hyperlink{REM}{REM}]{\emph  {Rapid Eye Movement} --- sommeil paradoxal}
\newacro{REST}[\AC@hyperlink{REST}{REST}]{\emph  {Representational State Transfer} --- style d'architecture pour les services web}
\newacro{RGPD}[\AC@hyperlink{RGPD}{RGPD}]{Règlement Général sur la Protection des Données}
\newacro{ROC}[\AC@hyperlink{ROC}{ROC}]{\emph  {Receiver Operating Characteristic} --- courbe de performance d'un classifieur binaire}
\newacro{SAOS}[\AC@hyperlink{SAOS}{SAOS}]{Syndrome d'Apnées Obstructives du Sommeil}
\newacro{SE}[\AC@hyperlink{SE}{SE}]{\emph  {Sleep Efficiency} --- efficacité du sommeil, rapport du temps de sommeil au temps passé au lit}
\newacro{SHAP}[\AC@hyperlink{SHAP}{SHAP}]{\emph  {SHapley Additive exPlanations} --- méthode d'explication fondée sur les valeurs de Shapley}
\newacro{SHHS}[\AC@hyperlink{SHHS}{SHHS}]{\emph  {Sleep Heart Health Study} --- cohorte multicentrique américaine d'étude du sommeil et du risque cardiovasculaire}
\newacro{SOL}[\AC@hyperlink{SOL}{SOL}]{\emph  {Sleep Onset Latency} --- latence d'endormissement}
\newacro{SPT}[\AC@hyperlink{SPT}{SPT}]{\emph  {Sleep Period Time} --- durée de la période de sommeil}
\newacro{TIB}[\AC@hyperlink{TIB}{TIB}]{\emph  {Time In Bed} --- temps passé au lit}
\newacro{TST}[\AC@hyperlink{TST}{TST}]{\emph  {Total Sleep Time} --- temps de sommeil total}
\newacro{VRAM}[\AC@hyperlink{VRAM}{VRAM}]{\emph  {Video Random Access Memory} --- mémoire du processeur graphique}
\newacro{WASO}[\AC@hyperlink{WASO}{WASO}]{\emph  {Wake After Sleep Onset} --- durée d'éveil intra-sommeil}
\newacro{XAI}[\AC@hyperlink{XAI}{XAI}]{\emph  {eXplainable Artificial Intelligence} --- intelligence artificielle explicable}
\newacro{XML}[\AC@hyperlink{XML}{XML}]{\emph  {eXtensible Markup Language} --- langage de balisage extensible}
